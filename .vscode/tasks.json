        {
            "label": "run-azurite-service",
            "type": "shell",
            "command": "azurite --inMemoryPersistence --skipApiVersionCheck",
            "options": {
                "cwd": "${workspaceFolder}/.vscode"
            },
            "problemMatcher": {
                "fileLocation": "absolute",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Executing task.*$",
                    "endsPattern": "^.*successfully listening at http://127.0.0.1:10002.*$"
                }
            },
            "isBackground": true
        },
