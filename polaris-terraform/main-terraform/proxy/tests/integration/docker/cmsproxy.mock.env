# ---------------------------------------------------------------------------
# Mock app settings for the cmsproxy integration tests.
#
# This file is the TEST-VALUE MANIFEST for every app setting the proxy config
# consumes. The canonical list of settings lives in docs/PROXY.md §2 — if a new
# app_setting is added to app-service-proxy.tf, add it here too or the config
# will render with an empty value.
#
# Everything the proxy dials is pointed at the single `mock-upstream` service:
#   http  -> mock-upstream:3000
#   https -> mock-upstream:3443   (self-signed; nginx does not verify by default)
#
# NOTE: NGINX_ENVSUBST_OUTPUT_DIR is set in docker-compose.yml, not here.
# NOTE: nginx's own runtime vars (${host}, ${ieaction}, ${request_uri}, ${args})
#       are NOT env vars — the nginx entrypoint only substitutes names that are
#       actually present in the environment, so they survive envsubst untouched.
# ---------------------------------------------------------------------------

# --- platform / host / scheme ---------------------------------------------
# 127.0.0.11 is Docker's embedded DNS, so nginx's `resolver` can resolve
# the `mock-upstream` service name.
WEBSITE_DNS_SERVER=127.0.0.11
WEBSITE_HOSTNAME=localhost
WEBSITE_SCHEME=http
ENDPOINT_HTTP_PROTOCOL=http
ENVIRONMENT=test

# --- rate limiting ---------------------------------------------------------
# Burst kept high so the limiter never fires during tests.
CMS_RATE_LIMIT=128r/s
CMS_RATE_LIMIT_QUEUE=100000

# --- polaris app backends --------------------------------------------------
APP_SUBFOLDER_PATH=polaris-ui
APP_ENDPOINT_DOMAIN_NAME=mock-upstream:3000
MATERIALS_APP_ENDPOINT_DOMAIN_NAME=mock-upstream:3000
API_ENDPOINT_DOMAIN_NAME=mock-upstream:3000
SAS_URL_DOMAIN_NAME=mock-upstream:3443
AUTH_HANDOVER_ENDPOINT_DOMAIN_NAME=mock-upstream:3000
DDEI_ENDPOINT_DOMAIN_NAME=mock-upstream:3000
DDEI_ENDPOINT_FUNCTION_APP_KEY=test-ddei-key-12345

# --- auth handover ---------------------------------------------------------
AUTH_HANDOVER_WHITELIST=/auth-refresh-inbound,https://cps.outsystemsenterprise.com/,http://allowed.example.org/

# --- CMS upstreams: DEFAULT (== CIN3) --------------------------------------
DEFAULT_UPSTREAM_CMS_IP_CORSHAM=mock-upstream:3000
DEFAULT_UPSTREAM_CMS_MODERN_IP_CORSHAM=mock-upstream:3000
DEFAULT_UPSTREAM_CMS_IP_FARNBOROUGH=mock-upstream:3000
DEFAULT_UPSTREAM_CMS_MODERN_IP_FARNBOROUGH=mock-upstream:3000
DEFAULT_UPSTREAM_CMS_DOMAIN_NAME=cms.cps.gov.uk
DEFAULT_UPSTREAM_CMS_SERVICES_DOMAIN_NAME=cms-services.cps.gov.uk
DEFAULT_UPSTREAM_CMS_MODERN_DOMAIN_NAME=cmsmodern.cps.gov.uk

# --- CMS upstreams: CIN2 ---------------------------------------------------
CIN2_UPSTREAM_CMS_IP_CORSHAM=mock-upstream:3000
CIN2_UPSTREAM_CMS_MODERN_IP_CORSHAM=mock-upstream:3000
CIN2_UPSTREAM_CMS_IP_FARNBOROUGH=mock-upstream:3000
CIN2_UPSTREAM_CMS_MODERN_IP_FARNBOROUGH=mock-upstream:3000
CIN2_UPSTREAM_CMS_DOMAIN_NAME=cin2.cps.gov.uk
CIN2_UPSTREAM_CMS_SERVICES_DOMAIN_NAME=not-used-in-cin2.cps.gov.uk
CIN2_UPSTREAM_CMS_MODERN_DOMAIN_NAME=cmsmodcin2.cps.gov.uk

# --- CMS upstreams: CIN4 ---------------------------------------------------
CIN4_UPSTREAM_CMS_IP_CORSHAM=mock-upstream:3000
CIN4_UPSTREAM_CMS_MODERN_IP_CORSHAM=mock-upstream:3000
CIN4_UPSTREAM_CMS_IP_FARNBOROUGH=mock-upstream:3000
CIN4_UPSTREAM_CMS_MODERN_IP_FARNBOROUGH=mock-upstream:3000
CIN4_UPSTREAM_CMS_DOMAIN_NAME=cin4.cps.gov.uk
CIN4_UPSTREAM_CMS_SERVICES_DOMAIN_NAME=not-used-in-cin4.cps.gov.uk
CIN4_UPSTREAM_CMS_MODERN_DOMAIN_NAME=cmsmodstage.cps.gov.uk

# --- CMS upstreams: CIN5 ---------------------------------------------------
CIN5_UPSTREAM_CMS_IP_CORSHAM=mock-upstream:3000
CIN5_UPSTREAM_CMS_MODERN_IP_CORSHAM=mock-upstream:3000
CIN5_UPSTREAM_CMS_IP_FARNBOROUGH=mock-upstream:3000
CIN5_UPSTREAM_CMS_MODERN_IP_FARNBOROUGH=mock-upstream:3000
CIN5_UPSTREAM_CMS_DOMAIN_NAME=cin5.cps.gov.uk
CIN5_UPSTREAM_CMS_SERVICES_DOMAIN_NAME=not-used-in-cin5.cps.gov.uk
CIN5_UPSTREAM_CMS_MODERN_DOMAIN_NAME=cmsmodcin5.cps.gov.uk

# --- CMS upstreams: CPT ----------------------------------------------------
# Added for FCT2-18732: the live nginx.conf now declares js_var $cptUpstream* from
# these ${CPT_*} app settings, so they MUST exist or the live-config run dies at boot
# with `[emerg] unknown "cpt_upstream_cms_ip_corsham" variable`. (The --next config
# resolves CPT via process.env in njs, so it doesn't need these to boot — but harmless.)
CPT_UPSTREAM_CMS_IP_CORSHAM=mock-upstream:3000
CPT_UPSTREAM_CMS_MODERN_IP_CORSHAM=mock-upstream:3000
CPT_UPSTREAM_CMS_IP_FARNBOROUGH=mock-upstream:3000
CPT_UPSTREAM_CMS_MODERN_IP_FARNBOROUGH=mock-upstream:3000
CPT_UPSTREAM_CMS_DOMAIN_NAME=cmscpt.cps.gov.uk
CPT_UPSTREAM_CMS_SERVICES_DOMAIN_NAME=not-used-in-cpt.cps.gov.uk
CPT_UPSTREAM_CMS_MODERN_DOMAIN_NAME=cmsmodcpt.cps.gov.uk

# --- global components (served from the adjacent global-components.conf) ----
WM_MDS_BASE_URL=http://mock-upstream:3000/api/
WM_MDS_ACCESS_KEY=test-mds-key-12345
CPS_GLOBAL_COMPONENTS_BLOB_STORAGE_DOMAIN=mock-upstream:3443

# --- non-DDEI init switch (feature auth-handover.drop1.replace-ddei) --------
# Off by default so --next stays behaviour-identical to the live monolith; the
# non-ddei path is isolated new-gen functionality, outside the golden master.
NON_DDEI_INIT_ENABLED=false

# --- Entra store switch + config (feature auth-handover.drop2.entra) --------
# Off by default (same golden-master reasoning as drop1). ENTRA_STORE_ENABLED is the
# only one envsubst'd into a .conf (the switch in auth-handover.conf); the rest are read
# via process.env in the njs at runtime and mirror the baked-in QA defaults so a manual
# `--next` run with the switch on can render + reach AD/storage. The two SECRETS
# (ENTRA_CLIENT_SECRET, ENTRA_STORAGE_KEY) stay empty here — set them as QA app settings.
ENTRA_STORE_ENABLED=false
ENTRA_TENANT_ID=00dd0d1d-d7e6-4338-ac51-565339c7088c
ENTRA_CLIENT_ID=8d6133af-9593-47c6-94d0-5c65e9e310f1
ENTRA_REDIRECT_URI=https://polaris-qa-notprod.cps.gov.uk/init-v2/callback
ENTRA_CLIENT_SECRET=
ENTRA_STORAGE_ACCOUNT=sacpsglobalcomponents
ENTRA_STORAGE_KEY=
ENTRA_STORAGE_TABLE=cmsauth
