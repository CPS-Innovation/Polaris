namespace coordinator.Functions;

using Common.Configuration;
using Common.Dto.Request;
using Common.Dto.Response;
using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Mvc;
using Microsoft.Azure.Functions.Worker;
using Microsoft.Azure.Functions.Worker.Http;
using Microsoft.DurableTask;
using Microsoft.DurableTask.Client;
using Microsoft.Extensions.Logging;
using System;
using System.Threading;
using System.Threading.Tasks;

public class RedactAndLogOrchestrator
{
    [Function(nameof(RedactAndLogOrchestrator))]
    public async Task<RedactAndLogResponse> RunOrchestrator(
        [OrchestrationTrigger] TaskOrchestrationContext context)
    {
        var input = context.GetInput<RedactAndLogOrchestrationInput>();

        try
        {
            var redactionResult =
                await context.CallActivityAsync<StepResult>(
                    nameof(RedactAndLogRedactionActivity),
                    input);

            if (redactionResult.Status != "Succeeded")
            {
                return new RedactAndLogResponse
                {
                    CorrelationId = input.CorrelationId,
                    Success = false,
                    Redaction = redactionResult,
                    Logging = null
                };
            }

            var loggingResult =
                await context.CallActivityAsync<StepResult>(
                    nameof(RedactAndLogLoggingActivity),
                    input);

            return new RedactAndLogResponse
            {
                CorrelationId = input.CorrelationId,
                Success = loggingResult.Status == "Succeeded",
                Redaction = redactionResult,
                Logging = loggingResult
            };
        }
        catch (Exception ex)
        {
            return new RedactAndLogResponse
            {
                CorrelationId = input.CorrelationId,
                Success = false,
                Redaction = new StepResult
                {
                    Status = "Failed",
                    Error = ex.Message
                }
            };
        }
    }

    [Function(nameof(RedactAndLogRedactionActivity))]
    public async Task<StepResult> Redact(
        [ActivityTrigger] RedactAndLogOrchestrationInput input)
    {
        try
        {
            await this.redactionService.ProcessAsync(
                input.CaseId,
                input.MaterialId,
                input.DocumentId,
                input.Request.RedactionPayload,
                input.CmsAuthValues,
                input.CorrelationId,
                CancellationToken.None);

            return new StepResult
            {
                Status = "Succeeded"
            };
        }
        catch (Exception ex)
        {
            this.logger.LogError(
                ex,
                "Redaction failed. CorrelationId: {CorrelationId}, CaseId: {CaseId}, MaterialId: {MaterialId}, DocumentId: {DocumentId}",
                input.CorrelationId,
                input.CaseId,
                input.MaterialId,
                input.DocumentId);

            return new StepResult
            {
                Status = "Failed",
                Error = ex.Message
            };
        }
    }

    [Function(nameof(RedactAndLogLoggingActivity))]
    public async Task<StepResult> Log(
    [ActivityTrigger] RedactAndLogOrchestrationInput input)
    {
        try
        {
            await this.loggerClient.CreateRedactionLog(
                input.Request.LogPayload,
                input.CorrelationId);

            return new StepResult
            {
                Status = "Succeeded"
            };
        }
        catch (Exception ex)
        {
            this.logger.LogError(
                ex,
                "Redaction logging failed. CorrelationId: {CorrelationId}, CaseId: {CaseId}, MaterialId: {MaterialId}, DocumentId: {DocumentId}",
                input.CorrelationId,
                input.CaseId,
                input.MaterialId,
                input.DocumentId);

            return new StepResult
            {
                Status = "Failed",
                Error = ex.Message
            };
        }
    }

    public class RedactAndLogOrchestrationInput
    {
        public int CaseId { get; set; }

        public string MaterialId { get; set; }

        public long DocumentId { get; set; }

        public Guid CorrelationId { get; set; }

        public RedactAndLogRequestDto Request { get; set; }

        public string CmsAuthValues { get; set; }
    }

    [Function(nameof(RedactAndLog))]
    [ProducesResponseType(StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status202Accepted)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    [ProducesResponseType(StatusCodes.Status401Unauthorized)]
    [ProducesResponseType(StatusCodes.Status500InternalServerError)]
    public async Task<IActionResult> HttpStart(
    [HttpTrigger(
        AuthorizationLevel.Anonymous,
        "put",
        Route = RestApi.RedactAndLog)]
    HttpRequest req,
    int caseId,
    string materialId,
    long documentId,
    CancellationToken cancellationToken,
    [DurableClient] DurableTaskClient orchestrationClient)
    {
        var correlationId = req.Headers.GetCorrelationId();
        var cmsAuthValues = req.BuildCmsAuthValues();

        // authentication...

        var request =
            await req.ReadFromJsonAsync<RedactAndLogRequestDto>(
                cancellationToken);

        if (request is null)
        {
            return new BadRequestObjectResult(...);
        }

        // validation...

        var orchestrationInput = new RedactAndLogOrchestrationInput
        {
            CaseId = caseId,
            MaterialId = materialId,
            DocumentId = documentId,
            CorrelationId = correlationId,
            CmsAuthValues = cmsAuthValues.CmsAuthFullValue,
            Request = request
        };

        var response =
            await this.redactAndLogService.StartOrReuseAsync(
                orchestrationInput,
                orchestrationClient,
                cancellationToken);

        return response;
    }
}